# Copy to .env and fill in real values. Do not put secrets here.

# --- REQUIRED ---
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=3001

# --- APP URLS ---
# Backend URL used by the React frontend (must be exposed to the client, so VITE_ prefix)
VITE_API_URL=http://localhost:3001/api
# Backend URL used by the backend itself for public links / webhooks
PUBLIC_API_URL=http://localhost:3001/api
# Frontend URL used by the backend for public links / redirects
PUBLIC_APP_URL=http://localhost:7100

# --- CORS / HTTPS ---
# Comma-separated list of allowed frontend origins (include https://yourdomain.com)
ALLOWED_ORIGINS=http://localhost:7100
# Set to true in production behind a terminating proxy to redirect HTTP to HTTPS
FORCE_HTTPS=false
# Set to true if the platform runs behind a trusted reverse proxy
TRUST_PROXY=false

# --- DATABASE ---
# Absolute or relative path to the SQLite file. Defaults to backend/data/db.sqlite
SQLITE_PATH=
# Set to true once to import backend/data/db.json into SQLite, then remove or set false
JSON_DB_PATH=backend/data/db.json
# Set to true to seed demo listings/agents. Leave false for production.
SEED_DEMO_DATA=false

# --- DUAL DATABASE ---
# Primary persistence engine: sqlite (default, current) or postgres (Phase 2+)
DB_PRIMARY=sqlite
# Enable SQLite mirror when Postgres is the primary (no-op while DB_PRIMARY=sqlite)
DB_MIRROR_SQLITE=true
# Postgres connection string; required when DB_PRIMARY=postgres
DATABASE_URL=
# Consistency mode on startup: warn (log and continue) or strict (abort on critical drift)
DB_CONSISTENCY_MODE=warn
# Run a startup consistency check between primary and mirror
DB_RECONCILE_ON_START=false
# Log every persistence query at debug level
DB_LOG_QUERIES=false

# --- MARKET PRICING / REB PRICE INDEX ---
# Requires PostgreSQL with PostGIS and all migrations through 026.
MARKET_PRICING_ENABLED=true
MARKET_PRICING_BASE_CURRENCY=USD
# Bootstrap/demo fallback only; production analysis requires a persisted accepted rate.
MARKET_PRICING_DEFAULT_PARALLEL_RATE=90000
MARKET_PRICING_CURRENCY_RATE_SOURCES=manual
MARKET_PRICING_DEFAULT_CURRENCY_RATE_SOURCE=manual
# Fresh through 24h; visibly stale through 168h; rejected after 168h.
MARKET_PRICING_RATE_FRESH_HOURS=24
MARKET_PRICING_RATE_MAX_STALE_HOURS=168
MARKET_PRICING_ANALYSIS_EXPIRY_DAYS=7
MARKET_PRICING_WORKER_ENABLED=true
MARKET_PRICING_WORKER_INTERVAL_MS=86400000
MARKET_PRICING_JOB_POLL_INTERVAL_MS=15000
MARKET_PRICING_JOB_BATCH_SIZE=25
MARKET_PRICING_JOB_MAX_ATTEMPTS=3
MARKET_PRICING_TREND_WORKER_INTERVAL_MS=2592000000
MARKET_PRICING_SEED_DEMO=false
MARKET_PRICING_WHATSAPP_CONTEXT_ENABLED=true
MARKET_PRICING_AI_PROVIDER=gemini
MARKET_PRICING_FALLBACK_AI_PROVIDERS=gemini,openai

# --- LOGGING ---
LOG_LEVEL=info

# --- DISTRIBUTION RETRY WORKER ---
# Enable/disable automatic retries for queued social distributions
DISTRIBUTION_RETRY_WORKER_ENABLED=true
# Poll interval for worker loop (milliseconds)
DISTRIBUTION_RETRY_WORKER_INTERVAL_MS=60000
# Max queued records processed per worker run
DISTRIBUTION_RETRY_WORKER_BATCH_SIZE=20
# Max retry attempts before a queued distribution is marked as failed
DISTRIBUTION_RETRY_MAX_ATTEMPTS=6
# Base backoff delay in milliseconds (doubles each attempt)
DISTRIBUTION_RETRY_BASE_DELAY_MS=300000

# --- CONSUMER JOURNEY AUTOMATION WORKER ---
# Enables background automation for saved-search digests, inquiry SLA reminders, and viewing no-show handling
CONSUMER_AUTOMATION_WORKER_ENABLED=true
# Poll interval for consumer automation loop (milliseconds)
CONSUMER_AUTOMATION_WORKER_INTERVAL_MS=120000
# Send viewing reminders when a scheduled viewing is within this many minutes
VIEWING_REMINDER_LEAD_MINUTES=120
# Automatically mark a scheduled/confirmed viewing as no-show after this grace window (minutes)
VIEWING_NO_SHOW_GRACE_MINUTES=90

# --- SMS ---
# dev | twilio
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- EMAIL ---
# dev | resend | sendgrid | smtp | ses
EMAIL_PROVIDER=dev
# Resend: recommended for transactional/conversation email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SendGrid: recommended for marketing and bulk distribution campaigns later
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Fallback shared sender address
EMAIL_FROM=
# Dev simulation flag
EMAIL_DEV_ALWAYS_SUCCESS=true

# --- META / WHATSAPP ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_BUSINESS_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=reb-whatsapp-verify
WHATSAPP_DEFAULT_RECIPIENT=

# --- INSTAGRAM ---
INSTAGRAM_PROVIDER=dev
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- OTHER PLATFORMS ---
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- WHATSAPP LISTINGS MODULE ---
WHATSAPP_LISTINGS_ENABLED=true
WHATSAPP_LISTINGS_STORAGE_PATH=backend/uploads/whatsapp-listings
WHATSAPP_LISTINGS_AI_PROVIDER=gemini
WHATSAPP_LISTINGS_FALLBACK_AI_PROVIDERS=gemini,openai
WHATSAPP_LISTINGS_INTAKE_WINDOW_MS=120000
WHATSAPP_LISTINGS_MAX_MEDIA_PER_DRAFT=15
WHATSAPP_LISTINGS_MAX_MEDIA_SIZE_BYTES=12582912
WHATSAPP_LISTINGS_INSTAGRAM_REAL_PUBLISHING=true
WHATSAPP_LISTINGS_WORKER_INTERVAL_MS=60000
WHATSAPP_LISTINGS_WORKER_BATCH_SIZE=20
WHATSAPP_LISTINGS_DEDUPE_TTL_HOURS=24
WHATSAPP_LISTINGS_SESSION_TTL_HOURS=24
WHATSAPP_LISTINGS_EXTRACTION_CREDIT_COST=0.05
WHATSAPP_LISTINGS_THUMBNAIL_CREDIT_COST=0.05
WHATSAPP_LISTINGS_CAPTION_CREDIT_COST=0.02
WHATSAPP_LISTINGS_SOCIAL_PUBLISH_CREDIT_COST=0.03
WHATSAPP_LISTINGS_OPENAI_API_KEY=
WHATSAPP_LISTINGS_GEMINI_API_KEY=
WHATSAPP_LISTINGS_CLAUDE_API_KEY=
WHATSAPP_LISTINGS_DEEPSEEK_API_KEY=
WHATSAPP_LISTINGS_QWEN_API_KEY=
WHATSAPP_LISTINGS_KIMI_API_KEY=

# --- GOOGLE MAPS (Area Intelligence) ---
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BUDGET_USD_MONTHLY=500
GOOGLE_MAPS_RATE_LIMIT_PER_MINUTE=100

# --- AREA INTELLIGENCE ---
AREA_INTELLIGENCE_ENABLED=true
AREA_INTELLIGENCE_AI_PROVIDER=gemini
AREA_INTELLIGENCE_SCORING_WORKER_ENABLED=true
AREA_INTELLIGENCE_SCORING_WORKER_INTERVAL_MS=3600000
AREA_INTELLIGENCE_GOOGLE_REFRESH_WORKER_ENABLED=true
AREA_INTELLIGENCE_GOOGLE_REFRESH_WORKER_INTERVAL_MS=2592000000
